# Copie este arquivo para .env e ajuste os valores.
# O .env nunca deve ser commitado (já está no .gitignore).

POSTGRES_USER=elo_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=elo
# Banco separado, usado exclusivamente pelos testes de integração (pytest).
# Nunca aponte para o mesmo valor de POSTGRES_DB: os testes truncam suas
# tabelas livremente, e isso apagaria dado carregado pelo pipeline. O nome
# deve terminar em "_test" (o suite recusa rodar caso contrário) - o banco
# é criado automaticamente na primeira execução do pytest, se não existir.
POSTGRES_TEST_DB=elo_test
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=troque_esta_senha_123
METABASE_DB_HOST=postgres